{
  "name": "@toiroakr/chisel",
  "version": "0.1.0",
  "description": "Progressive executable specifications for TypeScript",
  "type": "module",
  "bin": {
    "chisel": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./isolated": {
      "types": "./dist/isolated.d.ts",
      "import": "./dist/isolated.js"
    },
    "./report.schema.json": "./schema/report.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/cli.js verify examples/verified.spec.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "coverage": "vitest run --coverage",
    "demo": "tsx examples/progressive-demo/run.ts",
    "demo:type-break": "tsc -p examples/progressive-demo/type-break/tsconfig.json --pretty false",
    "example:check": "tsx src/cli.ts check examples/order-cancellation.spec.ts",
    "example:strict": "tsx src/cli.ts check examples/order-cancellation.spec.ts --strict",
    "example:generate": "tsx src/cli.ts generate examples/order-cancellation.spec.ts",
    "example:verified": "tsx src/cli.ts check examples/verified.spec.ts --strict",
    "prepublishOnly": "npm run check && npm run build"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "license": "MIT",
  "dependencies": {
    "@politty/zod": "^0.6.3",
    "decimal.js": "^10.6.0",
    "temporal-spec": "^1.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "^5.0.1",
    "pkg-pr-new": "0.0.91",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/chisel.git"
  }
}
